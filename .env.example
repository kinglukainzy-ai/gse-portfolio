# Copy this file to .env and fill in real values. Never commit the real .env.

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must be a real random value -- the backend refuses to start otherwise.
SECRET_KEY=

# From @BotFather when you create your bot.
BOT_TOKEN=

# The bot's @username (without the @), used by the frontend to render the
# Telegram Login Widget.
BOT_USERNAME=

# Comma-separated Telegram numeric user IDs allowed to log in / use the bot.
# Get your own ID by messaging @userinfobot on Telegram.
ALLOWED_IDS=111111111,222222222

# Set to "false" only for local HTTP testing; keep "true" in production
# (Caddy serves HTTPS, so the session cookie should require it).
COOKIE_SECURE=true

# Optional overrides, defaults shown:
# DB_PATH=/opt/gse-portfolio/backend/portfolio.db
# GSE_LIVE_URL=https://dev.kwayisi.org/apis/gse/live
